{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@bridgerpc/core": [
        "packages/core/src/index.ts"
      ],
      "@bridgerpc/schema": [
        "packages/schema/src/index.ts"
      ],
      "@bridgerpc/compiler": [
        "packages/compiler/src/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  }
}
