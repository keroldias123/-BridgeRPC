  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@omnirpc/core": ["packages/core/src/index.ts"],
      "@omnirpc/schema": ["packages/schema/src/index.ts"],
      "@omnirpc/compiler": ["packages/compiler/src/index.ts"]
    }
  }
}
